# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.

# App Key is public (the browser SDK needs it). Console > Applications > Key Management.
NEXT_PUBLIC_NEXCONN_APP_KEY=

# App Secret is private: server only, never prefix with NEXT_PUBLIC_, never commit.
NEXCONN_APP_SECRET=

# Must match the app's data center in the Console (Singapore here).
NEXCONN_API_PRIMARY=api.sg-light-api.com
NEXCONN_API_BACKUP=api-b.sg-light-api.com

# Google AI Studio key (free tier). The AI tries several Gemini models in order.
GEMINI_API_KEY=

# Groq key (free tier, optional). Used only when every Gemini model fails, as a safety net.
GROQ_API_KEY=

# Neon Postgres connection string (free tier). Run `node --env-file=.env.local scripts/migrate.mjs` once to create the tables.
DATABASE_URL=

# Passcode for the shop owner page at /owner. Use a long random string (12+ characters).
OWNER_PASSCODE=

# Optional. Signs seller and buyer session cookies. If empty, a key is derived from NEXCONN_APP_SECRET.
SESSION_SECRET=

# Optional. Browser pop-ups (Web Push). Create a pair with: npx web-push generate-vapid-keys
# The public key is not secret (the browser needs it); the private key is. Both must come from the same pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. Reply emails to buyers who are away, sent through Brevo (free: 300 emails a day).
# Use the SMTP login and SMTP key (Brevo > SMTP & API > SMTP), not the API key. BREVO_SENDER must be a verified sender.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER=

# Optional. Public address used in the links inside emails. Defaults to the live demo address.
SITE_URL=

# Optional. Comma-separated exact shop slugs to keep out of the public marketplace (directory, product grid, search, sitemap),
# e.g. test or placeholder shops. Their own pages, chat and staff sign-in keep working; pages ask search engines not to index them.
# Nothing is deleted. Leave empty to list every shop.
MARKETPLACE_UNLISTED_SLUGS=

# Optional. Leave unset. The retired single-shop app (/api/owner/*, /api/token, /api/shop, /api/order/confirm and its webhook bot) answers 404 unless this is 1.
ENABLE_LEGACY_SINGLE_SHOP=
